#!/usr/bin/env bash
set -eo pipefail
BUILD_DIR=${1:-}
cd $BUILD_DIR
mkdir -p vendor/yt
cd vendor/yt

BASE_URL="https://github.com/yt-dlp/yt-dlp/releases/latest/download"

curl --location "$BASE_URL/yt-dlp" -o yt-dlp
curl --location "$BASE_URL/SHA2-256SUMS" -o SHA2-256SUMS

# Проверяем только строку для файла yt-dlp
grep "^[a-f0-9]*  yt-dlp$" SHA2-256SUMS | sha256sum --check

chmod a+rx yt-dlp
rm SHA2-256SUMS
./yt-dlp --version

which yt-dlp
file $(which yt-dlp)

PROFILE_PATH="$BUILD_DIR/.profile.d/yt-dlp.sh"
mkdir -p $(dirname $PROFILE_PATH)
echo 'export PATH="$PATH:/app/vendor/yt"' >> $PROFILE_PATH
