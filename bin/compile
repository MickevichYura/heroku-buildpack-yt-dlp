#!/usr/bin/env bash
set -eo pipefail
BUILD_DIR=${1:-}
cd $BUILD_DIR
mkdir -p vendor/yt
cd vendor/yt

BASE_URL="https://github.com/yt-dlp/yt-dlp/releases/latest/download"

curl --location "$BASE_URL/yt-dlp_linux" -o yt-dlp
curl --location "$BASE_URL/SHA2-256SUMS" -o SHA2-256SUMS

grep "^[a-f0-9]*  yt-dlp_linux$" SHA2-256SUMS | sed 's/yt-dlp_linux/yt-dlp/' | sha256sum --check

chmod a+rx yt-dlp
rm SHA2-256SUMS
./yt-dlp --version

PROFILE_PATH="$BUILD_DIR/.profile.d/yt-dlp.sh"
mkdir -p $(dirname $PROFILE_PATH)
echo 'export PATH="$PATH:/app/vendor/yt"' >> $PROFILE_PATH
